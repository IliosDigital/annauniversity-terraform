            "id": "2852756058",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"StateObjects\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::qpgen-tfstate-850995535715/infra/dev/*\"\n    },\n    {\n      \"Sid\": \"StateList\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::qpgen-tfstate-850995535715\"\n    },\n    {\n      \"Sid\": \"ManageNamedResources\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sqs:*\",\n        \"sns:*\",\n        \"s3:*\",\n        \"lambda:*\",\n        \"events:*\",\n        \"dynamodb:*\"\n      ],\n      \"Resource\": [\n        \"arn:aws:sqs:ap-south-2:850995535715:qpgen-dev-*\",\n        \"arn:aws:sns:ap-south-2:850995535715:qpgen-dev-*\",\n        \"arn:aws:s3:::qpgen-dev-*\",\n        \"arn:aws:lambda:ap-south-2:850995535715:function:qpgen-dev-*\",\n        \"arn:aws:events:ap-south-2:850995535715:rule/qpgen-dev-*\",\n        \"arn:aws:dynamodb:ap-south-2:850995535715:table/qpgen-dev-*\"\n      ]\n    },\n    {\n      \"Sid\": \"ManageObjectsInNamedBuckets\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:*\",\n      \"Resource\": \"arn:aws:s3:::qpgen-dev-*/*\"\n    },\n    {\n      \"Sid\": \"ManageServices\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"xray:*\",\n        \"wafv2:*\",\n        \"tag:GetResources\",\n        \"logs:*\",\n        \"lambda:UpdateEventSourceMapping\",\n        \"lambda:ListEventSourceMappings\",\n        \"lambda:GetEventSourceMapping\",\n        \"lambda:DeleteEventSourceMapping\",\n        \"lambda:CreateEventSourceMapping\",\n        \"kms:*\",\n        \"es:*\",\n        \"ec2:*\",\n        \"cognito-idp:*\",\n        \"cloudwatch:*\",\n        \"cloudtrail:*\",\n        \"cloudfront:*\",\n        \"apigateway:*\"\n      ],\n      \"Resource\": \"*